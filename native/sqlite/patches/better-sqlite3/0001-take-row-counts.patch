+NODE_METHOD(Statement::JS_takeRowCounts) {
+	UNWRAP_OR_RETURN(Statement, stmt, info.This());
+	if (!stmt->alive) return ThrowTypeError(info.Env(), "The database connection is not open");
+	if (info.Length() < 1 || !info[0].IsTypedArray()
+		|| info[0].As<Napi::TypedArray>().TypedArrayType() != napi_float64_array
+		|| info[0].As<Napi::TypedArray>().ElementLength() < 2) {
+		return ThrowTypeError(info.Env(), "Expected a Float64Array of at least 2 elements to receive the row counts");
+	}
+	sqlite3_int64 rows_read = 0;
+	sqlite3_int64 rows_written = 0;
+	if (sirannon_stmt_status64(stmt->handle, LIBSQL_STMTSTATUS_ROWS_READ, &rows_read, 1) != SQLITE_OK
+		|| sirannon_stmt_status64(stmt->handle, LIBSQL_STMTSTATUS_ROWS_WRITTEN, &rows_written, 1) != SQLITE_OK) {
+		return ThrowTypeError(info.Env(), "SQLite reported no row counts for this statement");
+	}
+	Napi::Float64Array counts = info[0].As<Napi::Float64Array>();
+	counts[0] = static_cast<double>(rows_read);
+	counts[1] = static_cast<double>(rows_written);
+	return info.Env().Undefined();
+}
