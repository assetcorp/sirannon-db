The patch reads a database header through the file handle that SQLite holds,
without opening another descriptor or starting journal recovery.

--- a/src/objects/database.cpp
+++ b/src/objects/database.cpp
@@ -135,6 +135,7 @@
 		PrototypeMethod<Database, &Database::JS_close>("close", addon),
 		PrototypeMethod<Database, &Database::JS_defaultSafeIntegers>("defaultSafeIntegers", addon),
 		PrototypeMethod<Database, &Database::JS_unsafeMode>("unsafeMode", addon),
+		PrototypeMethod<Database, &Database::JS_readFileHeader>("readFileHeader", addon),
 		PrototypeMethod<Database, &Database::JS_key>("key", addon),
 		PrototypeMethod<Database, &Database::JS_startChangeCapture>("startChangeCapture", addon),
 		PrototypeMethod<Database, &Database::JS_takeCapturedChanges>("takeCapturedChanges", addon),
@@ -428,6 +429,35 @@
 	return info.Env().Undefined();
 }
 
+NODE_METHOD(Database::JS_readFileHeader) {
+	UNWRAP_OR_RETURN(Database, db, info.This());
+	REQUIRE_DATABASE_OPEN(db);
+	REQUIRE_DATABASE_NOT_BUSY(db);
+	REQUIRE_DATABASE_NO_ITERATORS(db);
+	sqlite3_file* file = NULL;
+	int status = sqlite3_file_control(db->db_handle, "main", SQLITE_FCNTL_FILE_POINTER, &file);
+	if (status != SQLITE_OK) {
+		ThrowSqliteError(info.Env(), db->addon, sqlite3_errstr(status), status);
+		return info.Env().Undefined();
+	}
+	if (file == NULL || file->pMethods == NULL) return info.Env().Null();
+	sqlite3_int64 size = 0;
+	status = file->pMethods->xFileSize(file, &size);
+	if (status != SQLITE_OK) {
+		ThrowSqliteError(info.Env(), db->addon, sqlite3_errstr(status), status);
+		return info.Env().Undefined();
+	}
+	const int header_bytes = 16;
+	int length = size < header_bytes ? static_cast<int>(size) : header_bytes;
+	Napi::Buffer<char> header = Napi::Buffer<char>::New(info.Env(), length);
+	if (length > 0) status = file->pMethods->xRead(file, header.Data(), length, 0);
+	if (status != SQLITE_OK) {
+		ThrowSqliteError(info.Env(), db->addon, sqlite3_errstr(status), status);
+		return info.Env().Undefined();
+	}
+	return header;
+}
+
 static const char RAW_KEY_HEX_DIGITS[] = "0123456789abcdef";
 static const size_t RAW_KEY_BYTES = 32;
 static const size_t RAW_KEYSPEC_BYTES = RAW_KEY_BYTES * 2 + 3;
