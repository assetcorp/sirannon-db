+
+SQLITE_API int sirannon_stmt_status64(
+  sqlite3_stmt *pStmt,
+  int op,
+  sqlite3_int64 *pValue,
+  int resetFlag
+){
+  Vdbe *pVdbe = (Vdbe*)pStmt;
+  if( pStmt==0 || pValue==0
+   || (op!=LIBSQL_STMTSTATUS_ROWS_READ && op!=LIBSQL_STMTSTATUS_ROWS_WRITTEN)
+  ){
+    return SQLITE_MISUSE_BKPT;
+  }
+  *pValue = (sqlite3_int64)pVdbe->aLibsqlCounter[op - LIBSQL_STMTSTATUS_BASE];
+  if( resetFlag ) pVdbe->aLibsqlCounter[op - LIBSQL_STMTSTATUS_BASE] = 0;
+  return SQLITE_OK;
 }

