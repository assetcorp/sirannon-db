+
+#define SIRANNON_CHANGE_CAPTURE_TRIGGER_PREFIX "_sirannon_trg_"
+#define SIRANNON_TABLE_PREFIX "_sirannon_"
+#define SIRANNON_OPFLAG_UNCOUNTED 0x80
+
+static int sirannonOwnsTable(const Table *pTab){
+  return pTab->zName!=0
+      && strncmp(pTab->zName, SIRANNON_TABLE_PREFIX, sizeof(SIRANNON_TABLE_PREFIX)-1)==0;
+}
+
+static SQLITE_NOINLINE int sirannonFrameCountsRows(const Vdbe *p){
+  const VdbeFrame *pFrame;
+  for(pFrame=p->pFrame; pFrame; pFrame=pFrame->pParent){
+    const Trigger *pTrigger = (const Trigger*)pFrame->token;
+    if( pTrigger && pTrigger->zName
+     && strncmp(pTrigger->zName, SIRANNON_CHANGE_CAPTURE_TRIGGER_PREFIX,
+                sizeof(SIRANNON_CHANGE_CAPTURE_TRIGGER_PREFIX)-1)==0
+    ){
+      return 0;
+    }
+  }
+  return 1;
+}
+
+static void sirannonAddRowCount(Vdbe *p, int op, u64 nRow){
+  if( p->pFrame==0 || sirannonFrameCountsRows(p) ){
+    p->aLibsqlCounter[op - LIBSQL_STMTSTATUS_BASE] += nRow;
+  }
+}

