 }

+static void sirannonExportFunc(
+  sqlite3_context *context,
+  int argc,
+  sqlite3_value **argv
+){
+  sqlite3 *db = sqlite3_context_db_handle(context);
+  const char *zTarget = (const char*)sqlite3_value_text(argv[0]);
+  int iTarget = zTarget ? sqlite3FindDbName(db, zTarget) : -1;
+  u64 saved_flags = db->flags;
+  u32 saved_mDbFlags = db->mDbFlags;
+  i64 saved_nChange = db->nChange;
+  i64 saved_nTotalChange = db->nTotalChange;
+  u8 saved_mTrace = db->mTrace;
+  char *zErrMsg = 0;
+  int rc;
+
+  UNUSED_PARAMETER(argc);
+  if( iTarget<2 ){
+    sqlite3_result_error(context,
+        "sirannon_export copies main into an attached database, and its argument names none", -1);
+    return;
+  }
+  db->flags |= SQLITE_WriteSchema | SQLITE_IgnoreChecks | SQLITE_Comments;
+  db->mDbFlags |= DBFLAG_PreferBuiltin | DBFLAG_Vacuum | DBFLAG_VacuumInto;
+  db->flags &= ~(u64)(SQLITE_ForeignKeys | SQLITE_ReverseOrder
+                   | SQLITE_Defensive | SQLITE_CountRows);
+  db->mTrace = 0;
+
+  db->init.iDb = iTarget;
+  rc = execSql(db, &zErrMsg,
+      "SELECT sql FROM main.sqlite_schema"
+      " WHERE type='table'AND name<>'sqlite_sequence'"
+      " AND coalesce(rootpage,1)>0");
+  if( rc==SQLITE_OK ){
+    rc = execSql(db, &zErrMsg,
+        "SELECT sql FROM main.sqlite_schema WHERE type='index'");
+  }
+  db->init.iDb = 0;
+  if( rc==SQLITE_OK ){
+    rc = execSqlF(db, &zErrMsg,
+        "SELECT'INSERT INTO \"%w\".'||quote(name)"
+        "||' SELECT*FROM main.'||quote(name)"
+        "FROM \"%w\".sqlite_schema "
+        "WHERE type='table'AND coalesce(rootpage,1)>0",
+        zTarget, zTarget);
+  }
+  db->mDbFlags &= ~DBFLAG_Vacuum;
+  if( rc==SQLITE_OK ){
+    rc = execSqlF(db, &zErrMsg,
+        "INSERT INTO \"%w\".sqlite_schema"
+        " SELECT*FROM main.sqlite_schema"
+        " WHERE type IN('view','trigger')"
+        " OR(type='table'AND rootpage=0)",
+        zTarget);
+  }
+
+  db->init.iDb = 0;
+  db->flags = saved_flags;
+  db->mDbFlags = saved_mDbFlags;
+  db->nChange = saved_nChange;
+  db->nTotalChange = saved_nTotalChange;
+  db->mTrace = saved_mTrace;
+  if( rc!=SQLITE_OK ){
+    sqlite3_result_error(context, zErrMsg ? zErrMsg : sqlite3ErrStr(rc), -1);
+    sqlite3_result_error_code(context, rc);
+  }
+  sqlite3DbFree(db, zErrMsg);
+}
+
+SQLITE_PRIVATE int sirannonRegisterExport(sqlite3 *db){
+  return sqlite3_create_function(db, "sirannon_export", 1,
+      SQLITE_UTF8 | SQLITE_DIRECTONLY, 0, sirannonExportFunc, 0, 0);
+}
+
 #endif  /* SQLITE_OMIT_VACUUM && SQLITE_OMIT_ATTACH */

