+SQLITE_API int
+sirannon_copy_codec(sqlite3* pDest, sqlite3* pSrc, const char* zSrcDb)
+{
+  int rc = SQLITE_OK;
+  Codec* srcCodec;
+  Codec* codec;
+  Btree* pBt;
+  int pageSize;
+  int reserved;
+
+  sqlite3_mutex_enter(pSrc->mutex);
+  srcCodec = sqlite3mcGetCodec(pSrc, zSrcDb);
+  if (srcCodec == NULL || !sqlite3mcIsEncrypted(srcCodec))
+  {
+    sqlite3_mutex_leave(pSrc->mutex);
+    return SQLITE_OK;
+  }
+  codec = (Codec*) sqlite3_malloc(sizeof(Codec));
+  rc = (codec != NULL) ? sqlite3mcCodecInit(codec) : SQLITE_NOMEM;
+  if (rc == SQLITE_OK)
+  {
+    rc = sqlite3mcCodecCopy(codec, srcCodec);
+  }
+  sqlite3_mutex_leave(pSrc->mutex);
+  if (rc != SQLITE_OK)
+  {
+    if (codec != NULL) sqlite3mcCodecFree(codec);
+    return rc;
+  }
+
+  sqlite3_mutex_enter(pDest->mutex);
+  if (!sqlite3mcIsEncryptionSupported(pDest, "main"))
+  {
+    sqlite3mcCodecFree(codec);
+    rc = SQLITE_ERROR;
+    sqlite3ErrorWithMsg(pDest, rc, "The backup destination opened through a VFS that cannot encrypt");
+    sqlite3_mutex_leave(pDest->mutex);
+    return rc;
+  }
+  pBt = pDest->aDb[0].pBt;
+  sqlite3mcSetDb(codec, pDest);
+  sqlite3mcSetBtree(codec, pBt);
+  pageSize = sqlite3mcGetPageSizeWriteCipher(codec);
+  reserved = sqlite3mcGetReservedWriteCipher(codec);
+  rc = mcAdjustBtree(pBt, pageSize, reserved, sqlite3mcGetLegacyWriteCipher(codec));
+  if (rc == SQLITE_OK)
+  {
+    sqlite3mcCodecSizeChange(codec, pageSize, reserved);
+    sqlite3mcSetCodec(pDest, "main", sqlite3_db_filename(pDest, "main"), codec);
+  }
+  else
+  {
+    sqlite3mcCodecFree(codec);
+  }
+  sqlite3_mutex_leave(pDest->mutex);
+  return rc;
+}

