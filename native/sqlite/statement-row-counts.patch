+NODE_METHOD(Statement::JS_takeRowCounts) {
+	UNWRAP_OR_RETURN(Statement, stmt, info.This());
+	if (!stmt->alive) return ThrowTypeError(info.Env(), "The database connection is not open");
+	UseIsolate;
+	const uint32_t rows_read = static_cast<uint32_t>(sqlite3_stmt_status(stmt->handle, LIBSQL_STMTSTATUS_ROWS_READ, 1));
+	const uint32_t rows_written = static_cast<uint32_t>(sqlite3_stmt_status(stmt->handle, LIBSQL_STMTSTATUS_ROWS_WRITTEN, 1));
+	Napi::Object result = Napi::Object::New(env);
+	result.Set("rowsRead", Napi::Number::New(env, rows_read));
+	result.Set("rowsWritten", Napi::Number::New(env, rows_written));
+	return result;
+}
