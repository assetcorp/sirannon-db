{
  "name": "@delali/sirannon-example-web-wa-sqlite",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Sirannon web-wa-sqlite example: a work order app on a real SQLite database in the browser that keeps working offline and syncs back to the server.",
  "scripts": {
    "server": "tsx src/data-server.ts",
    "app:dev": "vite",
    "app:dev:browser": "vite --mode browser-only",
    "dev": "concurrently -c blue,magenta \"pnpm run server\" \"pnpm run app:dev\"",
    "build": "vite build",
    "build:browser": "vite build --mode browser-only",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@delali/sirannon-db": "workspace:*",
    "@delali/sirannon-example-shared": "workspace:*",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-router": "1.170.10",
    "@tanstack/react-start": "1.168.18",
    "better-sqlite3": "12.6.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.17.0",
    "radix-ui": "1.5.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "4.10.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.69.0",
    "wa-sqlite": "1.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.2",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "9.2.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.0"
  }
}
